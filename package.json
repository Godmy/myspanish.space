{
  "name": "myspanish-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate": "wrangler d1 migrations apply myspanish-db",
    "db:migrate:local": "wrangler d1 migrations apply myspanish-db --local",
    "db:seed": "wrangler d1 execute myspanish-db --file=./migrations/seed.sql",
    "db:seed:local": "wrangler d1 execute myspanish-db --local --file=./migrations/seed.sql",
    "deploy": "yarn build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.5.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "stylist-svelte": "portal:../../stylist-svelte"
  }
}
