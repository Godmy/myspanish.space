{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myspanish-space",
  "main": "cloudflare/production-entry.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".svelte-kit-school-preview/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_TELEGRAM_LOGIN_BOT_USERNAME": "myspanish_space_quiz_bot",
    "ADMIN_TELEGRAM_IDS": "",
    "ADMIN_TELEGRAM_USERNAMES": "PavarenkinDA"
  },
  "routes": [
    {
      "pattern": "myspanish.space/*",
      "zone_name": "myspanish.space"
    },
    {
      "pattern": "www.myspanish.space/*",
      "zone_name": "myspanish.space"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myspanish-db",
      "database_id": "1c0b6112-e90b-48df-93ea-358f0422f3f8",
      "migrations_dir": "migrations"
    },
    {
      "binding": "QUIZ_DB",
      "database_name": "myspanish-quiz-db",
      "database_id": "90a9dfa5-f1c6-4bfd-86a8-b42426dffa43"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "16bb1af5cb65422c80382a688715df8d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "myspanish-media"
    }
  ],
  "account_id": "c98f42620906e66b20246d8402791a19",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHOOL",
        "class_name": "SchoolProduction"
      }
    ]
  },
  "migrations": [
    {
      "tag": "production-v1",
      "new_sqlite_classes": [
        "SchoolProduction"
      ]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ]
}
