NODE_ENV=production
SCHOOL_STORAGE=sqlite
SCHOOL_DATA_DIR=.school-production
HOST=127.0.0.1
PORT=3000
ORIGIN=http://127.0.0.1:3000
BODY_SIZE_LIMIT=12M
# For a public Node deployment, set ORIGIN to the actual HTTPS URL and use a
# reverse proxy with TLS. Set a private persistent absolute SCHOOL_DATA_DIR.
# Leave ARCHIVE_SOURCE_ROOT unset until a read-only archive source is selected.
