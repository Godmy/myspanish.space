{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myspanish-school-preview",
  "account_id": "c98f42620906e66b20246d8402791a19",
  "main": "cloudflare/preview-entry.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": ".svelte-kit-school/output/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PREVIEW_SCHOOL",
        "class_name": "SchoolPreview"
      }
    ]
  },
  "migrations": [
    {
      "tag": "preview-v1",
      "new_sqlite_classes": [
        "SchoolPreview"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ]
}
